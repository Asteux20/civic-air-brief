# Copy to .env (never commit .env). Every variable is read once in lib/config.js.

# Required: Gemini API key, server side only.
GEMINI_API_KEY=
# Optional: primary model (fallback gemini-flash-latest is tried on 404, 429 and 5xx).
GEMINI_MODEL=gemini-3.5-flash

# Optional: evaluator access code. Empty means open access.
ACCESS_CODE=airbrief2026
# Optional: global Gemini briefs per hour across all instances (1 to 10000, default 60).
MAX_BRIEFS_PER_HOUR=60

# Optional: shared store for rate limits and the brief cache (Upstash Redis REST).
# Either pair works; the Vercel Marketplace integration sets the KV_ pair.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
